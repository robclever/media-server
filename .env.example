APP_BIND=127.0.0.1:8080
MEDIA_DIR=./media
DATA_DIR=./data
COOKIE_SECURE=false
# Compose host settings:
HOST_MEDIA_DIR=./media
HOST_DATA_DIR=./data
PORT=8080
PLEX_IMAGE=custom-plex:local

# Optional JSON object of stable source names to paths; overrides MEDIA_DIR.
# Native example: MEDIA_SOURCES='{"default":"./media","archive":"/Volumes/Archive/Movies"}'
# Docker: use container paths and mount each additional folder (see README).
MEDIA_SOURCES=
# With compose.storage.example.yaml copied to compose.override.yaml:
# HOST_ARCHIVE_DIR=/mnt/archive/Movies
# MEDIA_SOURCES='{"default":"/media","archive":"/media-archive"}'
